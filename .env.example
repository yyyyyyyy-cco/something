# ===== monopoly 服务配置（复制为 .env 使用：cp .env.example .env）=====

# 容器内监听端口（不要映射到宿主；nginx-proxy 按容器名反代）
PORT=3000

# 数据目录（容器内路径；对应 docker-compose 的 ./data bind mount）
DATA_DIR=/app/data

# 客户端构建产物目录（默认自动探测，通常无需修改）
# CLIENT_DIST=/app/apps/client/dist

# 日志级别：debug | info | warn | error
LOG_LEVEL=info
